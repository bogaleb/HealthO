{
  "name": "projectos-health",
  "private": true,
  "version": "0.3.0-rc.1",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @projectos/web dev",
    "build": "pnpm --filter @projectos/web build",
    "start": "pnpm --filter @projectos/web start",
    "worker": "pnpm --filter @projectos/worker start",
    "db:generate": "pnpm --filter @projectos/db generate",
    "db:migrate": "pnpm --filter @projectos/db migrate",
    "db:seed": "pnpm --filter @projectos/core seed && pnpm --filter @projectos/credentialing seed && pnpm --filter @projectos/scheduling seed && pnpm --filter @projectos/rcm seed && pnpm --filter @projectos/compliance seed",
    "db:reset": "pnpm --filter @projectos/db reset && pnpm db:migrate && pnpm db:seed",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:e2e": "playwright test",
    "ops:restore-drill": "pnpm --filter @projectos/compliance drill:restore",
    "ops:rehearsal": "pnpm --filter @projectos/compliance rehearsal",
    "security:scan": "node scripts/security/scan-secrets.mjs",
    "security:audit": "pnpm audit --prod --audit-level=high",
    "build:bundles": "node scripts/build/bundle-node.mjs",
    "check:dockerfile": "node scripts/build/check-dockerfile.mjs",
    "release:migrate": "pnpm --filter @projectos/compliance release:migrate",
    "ops:migration-drill": "pnpm --filter @projectos/compliance drill:migration",
    "ops:clean-restore": "pnpm --filter @projectos/compliance drill:clean-restore",
    "ops:load-test": "node scripts/ops/load-test.mjs",
    "security:scan-logs": "node scripts/security/scan-logs.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@next/eslint-plugin-next": "16.4.2",
    "@playwright/test": "1.56.1",
    "@projectos/auth": "workspace:*",
    "@projectos/core": "workspace:*",
    "@projectos/credentialing": "workspace:*",
    "@projectos/db": "workspace:*",
    "@projectos/shared": "workspace:*",
    "@types/node": "22.20.5",
    "drizzle-orm": "0.45.4",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "kysely": "0.29.7",
    "postgres": "3.4.9",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.12"
  },
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "^0.25.12"
    }
  }
}
