{
  "name": "projectos-health",
  "private": true,
  "version": "0.2.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @projectos/web dev",
    "build": "pnpm --filter @projectos/web build",
    "start": "pnpm --filter @projectos/web start",
    "worker": "pnpm --filter @projectos/worker start",
    "db:generate": "pnpm --filter @projectos/db generate",
    "db:migrate": "pnpm --filter @projectos/db migrate",
    "db:seed": "pnpm --filter @projectos/core seed && pnpm --filter @projectos/credentialing seed",
    "db:reset": "pnpm --filter @projectos/db reset && pnpm db:migrate && pnpm db:seed",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "15.5.28",
    "@playwright/test": "1.56.1",
    "@projectos/auth": "workspace:*",
    "@projectos/core": "workspace:*",
    "@projectos/credentialing": "workspace:*",
    "@projectos/db": "workspace:*",
    "@projectos/shared": "workspace:*",
    "@types/node": "22.20.5",
    "drizzle-orm": "0.45.4",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "kysely": "0.29.7",
    "postgres": "3.4.9",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "3.2.7"
  }
}
