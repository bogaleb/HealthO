# ---- ProjectOS Health local configuration (copy to .env) ----
# Product maturity mode: DEVELOPMENT | DEMO_SYNTHETIC | PILOT_APPROVED | PRODUCTION_APPROVED
# Only DEVELOPMENT and DEMO_SYNTHETIC are usable today. No PHI in any mode until the go-live gate is signed.
APP_MODE=DEVELOPMENT

# PostgreSQL 16+ (docker compose exposes this on 127.0.0.1:5433 (5433 avoids clashing with a locally installed Postgres))
DATABASE_URL=postgresql://projectos:projectos_dev_password@127.0.0.1:5433/projectos
# Separate database used by integration tests (it is wiped by the tests)
TEST_DATABASE_URL=postgresql://projectos:projectos_dev_password@127.0.0.1:5433/projectos_test

# Better Auth: generate with `openssl rand -base64 32`. Never commit a real value.
BETTER_AUTH_SECRET=replace-with-32+-random-characters-for-local-dev-only
BETTER_AUTH_URL=http://localhost:3000

# Synthetic demo accounts created by `pnpm db:seed` all use this password.
# Choose your own locally; it is never shown in the UI.
DEMO_PASSWORD=change-me-local-demo-only

LOG_LEVEL=info

# Phase 4–5 scheduling. Booking is a SYNTHETIC DEMO only: it requires a synthetic APP_MODE *and* this flag.
# Every booking is decided by the Phase 5 eligibility engine using DEMO (not verified-law) policy rules.
# Any other value (or unset) disables booking, holds and rescheduling.
SCHEDULING_MODE=DEMO_ONLY
# How long a temporary hold blocks a slot (minutes, 1–30). Expired holds are released by `pnpm worker`.
SCHEDULING_HOLD_MINUTES=5

# Phase 6 worker (`pnpm worker`): how often it polls Postgres (ms). Each tick releases expired holds, runs due jobs,
# queues due-soon/overdue reminders and delivers the notification outbox (in-app only — no email/SMS in this phase).
WORKER_POLL_MS=15000

# Phase 7 security. MFA is ALWAYS required for privileged roles outside synthetic modes; set true to rehearse it locally.
REQUIRE_MFA_FOR_PRIVILEGED=false
# Restore drill (`pnpm ops:restore-drill`) encrypts the dump with this key (>= 32 chars). Keep it OUT of the backup location.
# BACKUP_ENCRYPTION_KEY=   (generate: openssl rand -hex 32; also used by `pnpm release:migrate` pre-migration backups)

# Phase 8 hardening
# Comma-separated CIDRs of the reverse proxies / load balancer in front of the web app. Better Auth then takes the
# client IP from the right-most untrusted X-Forwarded-For entry (per-IP sign-in limits). Leave empty locally.
TRUSTED_PROXY_CIDRS=
# Release identity shown by /api/v1/health/live (set by CI / the Docker build; optional locally).
# APP_VERSION=0.3.0-rc.1
# GIT_SHA=
# Cloud deployments may set DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD (+ DB_SSLMODE, default verify-full) instead of
# DATABASE_URL so the password comes straight from the secret store. DATABASE_URL wins when both are set.
